<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.de-gupta</groupId>
        <artifactId>cleanCrudParent</artifactId>
        <version>0.1.5</version>
    </parent>

    <artifactId>cleanCrud-sampleImplementation</artifactId>
    <version>0.4.0</version>

    <name>cleaCrud-sampleImplementation</name>
    <description>A sample implementation of the clean crud library</description>
    <url>https://github.com/de-gupta/cleanCrud-sampleImplementation.git</url>

    <properties>
        <argLine />
        <cleanCrud.version>0.9.0</cleanCrud.version>
        <it.tag.expression>fast | medium</it.tag.expression>
        <test.jvm.args>-Djdk.attach.allowAttachSelf=true -XX:+EnableDynamicAgentLoading</test.jvm.args>
        <test.mode>medium</test.mode>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.de-gupta</groupId>
            <artifactId>cleanCrud</artifactId>
            <version>${cleanCrud.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.de-gupta</groupId>
            <artifactId>aegis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <scm>
        <connection>scm:git:ssh://git@github.com/de-gupta/cleanCrud-sampleImplementation.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/de-gupta/cleanCrud-sampleImplementation.git</developerConnection>
        <url>https://github.com/de-gupta/cleanCrud-sampleImplementation.git</url>
        <tag>v0.4.0</tag>
    </scm>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${argLine} ${test.jvm.args}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>${argLine} ${test.jvm.args}</argLine>
                    <properties>
                        <configurationParameters>junit.jupiter.tags.include = ${it.tag.expression}</configurationParameters>
                    </properties>
                    <systemPropertyVariables>
                        <testMode>${test.mode}</testMode>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>fast-it</id>
            <properties>
                <it.tag.expression>fast</it.tag.expression>
                <test.mode>fast</test.mode>
            </properties>
        </profile>
        <profile>
            <id>medium-it</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <it.tag.expression>fast | medium</it.tag.expression>
                <test.mode>medium</test.mode>
            </properties>
        </profile>
        <profile>
            <id>full-it</id>
            <properties>
                <it.tag.expression>fast | medium | full</it.tag.expression>
                <test.mode>full</test.mode>
            </properties>
        </profile>
    </profiles>
</project>