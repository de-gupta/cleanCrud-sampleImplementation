@baseUrl = {{baseUrl}}
@taskId = 1

### Create task with inline version and notes
POST {{baseUrl}}/task/save
Accept: application/json
Content-Type: application/json

{
  "title": "Relationship smoke task 900001",
  "description": "Created from updated IntelliJ request file 900001",
  "versions": [
    {
      "version": 900001
    }
  ],
  "notes": [
    {
      "note": "task note one 900001"
    },
    {
      "note": "task note two 900001"
    }
  ]
}

> {%
 client.global.set("taskId", response.body.id);
%}

### Fetch created task
GET {{baseUrl}}/task/fetch/{{taskId}}
Accept: application/json

### Patch task scalar + owned collections
PATCH {{baseUrl}}/task/update/{{taskId}}
Accept: application/json
Content-Type: application/json

{
  "title": "Relationship smoke task updated 900001",
  "description": "Updated from IntelliJ smoke file 900001",
  "versions": [
    {
      "patch": {
        "version": 900002
      }
    }
  ],
  "notes": [
    {
      "patch": {
        "note": "task note added via patch 900001"
      }
    }
  ]
}

### Fetch all tasks
GET {{baseUrl}}/task/fetch
Accept: application/json